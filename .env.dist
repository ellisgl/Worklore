# Copy to .env (`make` does this automatically) and adjust locally. .env is git-ignored.
NGINX_VERSION=1.31.8
PHP_VERSION=8.5
# 18.7 is not yet published on Docker Hub; bump this when it is.
POSTGRES_VERSION=18.6

HTTP_PORT=8080
DB_PORT=5432

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me

# Test database (created on first start by docker/postgres/initdb/, used by App/.env.test)
POSTGRES_TEST_DB=test
POSTGRES_TEST_USER=test
POSTGRES_TEST_PASSWORD=change_me
