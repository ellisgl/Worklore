# Copy to .env (`make` does this automatically) and adjust locally. .env is git-ignored.
NGINX_VERSION=1.31.8
PHP_VERSION=8.5
# 18.7 is not yet published on Docker Hub; bump this when it is.
POSTGRES_VERSION=18.6
FLOCI_VERSION=2.4.0

HTTP_PORT=8080
DB_PORT=5432
# Floci, the S3 emulator, from the host (e.g. aws --endpoint-url http://localhost:4566)
S3_PORT=4566

# Largest request body nginx and PHP accept: journal media uploads and import
# archives. Keep it above App/.env MEDIA_MAX_FILE_SIZE, and big enough for an
# import of a full account (MEDIA_USER_QUOTA plus a little).
UPLOAD_LIMIT=1100M

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me

# Test database (created on first start by docker/postgres/initdb/, used by App/.env.test)
POSTGRES_TEST_DB=test
POSTGRES_TEST_USER=test
POSTGRES_TEST_PASSWORD=change_me
