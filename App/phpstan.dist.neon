# Static analysis: make stan (also runs in CI).
parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/bootstrap.php
    # Symfony extension: service and parameter types from the compiled container
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    # Doctrine extension: entity mappings, DQL and repository types
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        -
            # The modules map their owner to App\Shared\Owner, which doctrine.yaml's
            # resolve_target_entities resolves to App\Identity\User. The Doctrine
            # extension doesn't apply that setting, so it expects User.
            message: '#^Property App\\(Company|Journal|Taxonomy)\\\w+::\$owner type mapping mismatch: property can contain App\\Shared\\Owner but database expects App\\Identity\\User\.$#'
