<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Journal\JournalEntryEntity" table="journal_entry" repository-class="App\Journal\JournalEntryRepository">
        <indexes>
            <!-- Entries are listed per project, newest first -->
            <index name="idx_journal_entry_project_created" columns="project_id,created_at"/>
        </indexes>

        <!-- UUIDv7, assigned in the constructor; native PostgreSQL UUID column -->
        <id name="id" type="uuid"/>

        <field name="title">
            <options>
                <option name="comment">The title of the entry</option>
            </options>
        </field>
        <field name="entry" type="text">
            <options>
                <option name="comment">The content body of the entry.</option>
            </options>
        </field>
        <field name="createdAt" column="created_at" type="datetime_immutable">
            <options>
                <option name="comment">When the record was added</option>
            </options>
        </field>
        <field name="archivedAt" column="archived_at" type="datetime_immutable" nullable="true">
            <options>
                <option name="comment">A date time denotes the item was archived</option>
            </options>
        </field>

        <many-to-one field="user" target-entity="App\Entity\User">
            <join-column name="user_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="project" target-entity="App\Company\ProjectEntity" inversed-by="journalEntries">
            <join-column name="project_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-many field="tags" target-entity="App\Taxonomy\TagEntity">
            <join-table name="journal_entry_tag">
                <join-columns>
                    <join-column name="journal_entry_id" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="tag_id" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>
</doctrine-mapping>
