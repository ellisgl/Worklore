<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Taxonomy\TagEntity" table="tag">
        <unique-constraints>
            <!-- Tag names are unique within their category, ignoring case
                 (archived ones included) -->
            <unique-constraint name="uniq_tag_category_name" columns="category_id,name_key"/>
        </unique-constraints>
        <indexes>
            <index name="idx_tag_user_archived" columns="user_id,archived_at"/>
        </indexes>

        <!-- UUIDv7, assigned in the constructor; native PostgreSQL UUID column -->
        <id name="id" type="tag_id"/>

        <field name="name" type="name" length="255">
            <options>
                <option name="comment">Name of the tag</option>
            </options>
        </field>
        <field name="nameKey" column="name_key" length="255">
            <options>
                <option name="comment">Lowercased, trimmed name; makes the unique constraint case-insensitive</option>
            </options>
        </field>
        <field name="createdAt" column="created_at" type="datetime_immutable">
            <options>
                <option name="comment">When the record was added</option>
            </options>
        </field>
        <field name="archivedAt" column="archived_at" type="datetime_immutable" nullable="true">
            <options>
                <option name="comment">A date time denotes the item was archived</option>
            </options>
        </field>

        <many-to-one field="category" target-entity="App\Taxonomy\CategoryEntity" inversed-by="tags">
            <join-column name="category_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="owner" target-entity="App\Shared\Owner">
            <join-column name="user_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

    </entity>
</doctrine-mapping>
