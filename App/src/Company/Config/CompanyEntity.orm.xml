<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Company\CompanyEntity" table="company" repository-class="App\Company\CompanyRepository">
        <unique-constraints>
            <!-- A user can't have two companies with the same name, ignoring case
                 (archived ones included) -->
            <unique-constraint name="uniq_company_user_name" columns="user_id,name_key"/>
        </unique-constraints>
        <indexes>
            <index name="idx_company_user_archived" columns="user_id,archived_at"/>
        </indexes>

        <!-- UUIDv7, assigned in the constructor; native PostgreSQL UUID column -->
        <id name="id" type="uuid"/>

        <field name="name">
            <options>
                <option name="comment">Name of the company</option>
            </options>
        </field>
        <field name="nameKey" column="name_key" length="255">
            <options>
                <option name="comment">Lowercased, trimmed name; makes the unique constraint case-insensitive</option>
            </options>
        </field>
        <field name="overview" type="text" nullable="true">
            <options>
                <option name="comment">Overview of the company</option>
            </options>
        </field>
        <field name="createdAt" column="created_at" type="datetime_immutable">
            <options>
                <option name="comment">When the record was added</option>
            </options>
        </field>
        <field name="archivedAt" column="archived_at" type="datetime_immutable" nullable="true">
            <options>
                <option name="comment">A date time denotes the item was archived</option>
            </options>
        </field>

        <one-to-many field="products" target-entity="App\Company\ProductEntity" mapped-by="company"/>

        <!-- A user can hold several positions at one company; newest first -->
        <one-to-many field="positions" target-entity="App\Company\PositionEntity" mapped-by="company">
            <order-by>
                <order-by-field name="startDate" direction="DESC"/>
            </order-by>
        </one-to-many>

        <many-to-one field="user" target-entity="App\Identity\User">
            <join-column name="user_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
