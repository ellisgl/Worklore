<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Company\ProjectEntity" table="project" repository-class="App\Company\ProjectRepository">
        <indexes>
            <index name="idx_project_archived_at" columns="archived_at"/>
        </indexes>

        <!-- UUIDv7, assigned in the constructor; native PostgreSQL UUID column -->
        <id name="id" type="uuid"/>
        <field name="name">
            <options>
                <option name="comment">Name of the project</option>
            </options>
        </field>
        <field name="overview" type="text" nullable="true">
            <options>
                <option name="comment">Overview of the project</option>
            </options>
        </field>
        <field name="createdAt" column="created_at" type="datetime_immutable">
            <options>
                <option name="comment">When the record was added</option>
            </options>
        </field>
        <field name="archivedAt" column="archived_at" type="datetime_immutable" nullable="true">
            <options>
                <option name="comment">A date time denotes the item was archived</option>
            </options>
        </field>

        <one-to-many field="journalEntries" target-entity="App\Journal\JournalEntryEntity" mapped-by="project"/>

        <many-to-one field="product" target-entity="App\Company\ProductEntity" inversed-by="projects">
            <join-column name="product_id" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="user" target-entity="App\Entity\User">
            <join-column name="user_id" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-many field="tags" target-entity="App\Taxonomy\TagEntity">
            <join-table name="project_tag">
                <join-columns>
                    <join-column name="project_id" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="tag_id" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

    </entity>
</doctrine-mapping>
